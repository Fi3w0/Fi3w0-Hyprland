{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/fastfetch/images/arch.png",
    	"type": "kitty-direct",
    	"height": 12,
    	"padding": {
    		"top": 1
    	}
    },
    "display": {
        "separator": " "
    },
    "modules": [
        
        {
            "type": "custom",
            "format": "\u001b[35m┌─── Software / System ──────────────────┐"
        },
	
        {
            "type": "os",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "host",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "command",
            "key": " ", 
            "keyColor": "35",
            "text": "PACMAN_COUNT=$(pacman -Q | wc -l); FLATPAK_COUNT=$(flatpak list | wc -l); NIX_COUNT=$(nix-env -q 2>/dev/null | wc -l); echo \"$PACMAN_COUNT (pacman), $FLATPAK_COUNT (flatpak), $NIX_COUNT (nix)\""
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "35"
        },
        
        {
            "type": "custom",
            "format": "\u001b[35m┌─── Hardware ───────────────────────────┐"
        },

        {
            "type": "display",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "35"
        },
        {
            "type": "swap",
            "key": "󰾴 ",
            "keyColor": "35"
        },
        
        {
            "type": "custom",
            "format": "\u001b[35m┌─── Storage ────────────────────────────┐"
        },
        
        {
            "type": "disk",
            "key": " ",
            "keyColor": "35"
        },
        
        {
            "type": "custom",
            "format": "\u001b[35m┌─── Uptime / Age ───────────────────────┐"
        },
        
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "command",
            "key": "󱦟 ",
            "keyColor": "35",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        }
    ]
}
